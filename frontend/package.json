{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:parser": "npx tsx scripts/test-semantic-parser.ts",
    "test:parser:verbose": "DEBUG=parser* npx tsx scripts/test-semantic-parser.ts",
    "debug:parser": "npx tsx scripts/debug-parser-step.ts",
    "test:metadata:generate": "node scripts/generate-expected-metadata.js",
    "test:metadata": "npx tsx scripts/test-metadata.ts",
    "test:metadata:fix": "npx tsx scripts/auto-fix-metadata.ts",
    "test:metadata:all": "npm run test:metadata:generate && npm run test:metadata",
    "validate": "cd ../backend && ./venv/bin/python -m src.validate_pipeline"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.624",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.4.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
