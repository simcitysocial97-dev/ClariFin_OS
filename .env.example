# ClariFin OS Environment Variables
# ================================
# Copy this file to .env and customize for your deployment.
# All values have sensible defaults for local development.

# Backend API URL (for frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration
# Path to SQLite database file (relative to project root)
DATABASE_PATH=./data/finance.db

# Upload Directory
# Directory for uploaded PDF/CSV files
UPLOAD_DIR=./data/uploads

# Server Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins (optional, defaults to localhost)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format (Python logging format string)
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# File Upload Limits
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf,.csv,.xlsx,.xls

# Feature Flags
# Enable/disable analytics engine
ENABLE_ANALYTICS=true

# Enable/disable behavior analysis engine
ENABLE_BEHAVIOR_ENGINE=true