  affects_cashflow: {
    color: edgeTypeColors.affects_cashflow,
    strokeWidth: 1,
    animation: 'none',
  },

  amortizes: {
    color: edgeTypeColors.amortizes,
    strokeWidth: 1,
    animation: 'none',
  },

  has_statement: {
    color: edgeTypeColors.has_statement,
    strokeWidth: 1,
    animation: 'none',
  },

  has_holding: {
    color: edgeTypeColors.has_holding,
    strokeWidth: 1,
    animation: 'none',
