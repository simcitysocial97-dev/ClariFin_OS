  .fin-section-header {
    font-family: var(--font-sans);
    font-size: var(--fs-lg);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }

  .fin-panel-header {
    font-family: var(--font-sans);
    font-size: var(--fs-base);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--text-primary);
  }

  .fin-body {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    line-height: var(--lh-normal);
    color: var(--text-primary);
  }

  .fin-body-small {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-regular);
    line-height: var(--lh-tight);
    color: var(--text-secondary);
  }

  .fin-caption {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-regular);
    line-height: var(--lh-tight);
    color: var(--text-tertiary);
  }

  .fin-hint {
    font-family: var(--font-sans);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-regular);
    line-height: var(--lh-none);
    color: var(--text-disabled);
  }

  .fin-mono {
    font-family: var(--font-mono);
  }

  .fin-sans {
    font-family: var(--font-sans);
  }

  /* ================================================================
     Graph Theme Styles
     ================================================================ */

  /* === Node Selection Halo === */
  .fin-node-selected::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 2px var(--color-selection);
    pointer-events: none;
  }

  .fin-node-halo {
    box-shadow: 0 0 0 4px var(--color-selection-halo);
  }

  /* === Edge Styles === */
  .fin-edge-money-flow {
    stroke: var(--color-edge-money-flow);
    stroke-width: 2;
  }

  .fin-edge-default {
    stroke: var(--color-edge-default);
    stroke-width: 1;
  }

  .fin-edge-projections {
    stroke: var(--color-edge-projection);
    stroke-width: 1;
    stroke-dasharray: 5, 5;
  }

  .fin-edge-simulation {
    stroke: var(--color-simulation-stroke);
    stroke-width: 1;
    stroke-dasharray: 5, 5;
    animation: fin-dash var(--duration-slow) linear infinite;
  }

  .fin-edge-evidence {
    stroke: var(--color-evidence-stroke);
    stroke-width: 1;
    stroke-dasharray: 3, 3;
  }

  .fin-edge-traversal {
    stroke: var(--color-traversal);
    stroke-width: 2;
    filter: drop-shadow(0 0 4px var(--color-traversal));
  }

  /* === Traversal Path === */
  .fin-traversal-path {
    stroke: var(--color-traversal);
    stroke-width: 2;
    fill: none;
    opacity: 0.6;
  }

  /* === Simulation Pulse === */
  .fin-simulation-pulse {
    animation: fin-pulse-sim var(--duration-slow) ease-in-out infinite;
  }

  /* === Risk Pulse === */
  .fin-risk-pulse {
    animation: fin-pulse-risk var(--duration-slow) ease-in-out infinite;
  }

  @keyframes fin-pulse-risk {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.15); }
  }

  @keyframes fin-pulse-sim {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  @keyframes fin-dash {
    from { stroke-dashoffset: 10; }
    to { stroke-dashoffset: 0; }
  }

  /* ================================================================
     Premium Motion — Stage 8H
     ================================================================ */

  /* === Money Flow Animation === */
  .fin-money-flow {
    animation: fin-flow-move 2s ease-in-out infinite;
  }

  @keyframes fin-flow-move {
    0% { stroke-dashoffset: 20; opacity: 0.4; }
    50% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0.4; }
  }

  /* === Selection Halo === */
  @keyframes fin-halo-appear {
    0% { box-shadow: 0 0 0 0px var(--color-selection-halo); }
    100% { box-shadow: 0 0 0 4px var(--color-selection-halo); }
  }

  .fin-selection-halo {
    animation: fin-halo-appear var(--duration-fast) var(--ease-out) forwards;
  }

  /* === Panel Open === */
  @keyframes fin-panel-enter {
    0% { opacity: 0; transform: translateY(4px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .fin-panel-enter {
    animation: fin-panel-enter 150ms var(--ease-out) forwards;
  }

  /* === Skeleton Loading === */
  .fin-skeleton {
    background: linear-gradient(
      90deg,
      var(--surface-default) 25%,
      var(--surface-interactive) 50%,
      var(--surface-default) 75%
    );
    background-size: 200% 100%;
    animation: fin-shimmer 1.5s ease-in-out infinite;
    border-radius: var(--radius-sm);
  }

  .fin-skeleton-text {
    height: 12px;
    width: 100%;
    margin-bottom: 6px;
  }

  .fin-skeleton-text:last-child {
    width: 60%;
  }

  /* === Inspector Section Enter === */
  .fin-inspector-section {
    animation: fin-panel-enter 120ms var(--ease-out) forwards;
  }

  /* === Graph Node Enter === */
  @keyframes fin-node-enter {
    0% { opacity: 0; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1); }
  }

  .fin-node-enter {
    animation: fin-node-enter var(--duration-fast) var(--ease-out) forwards;
  }

  /* === Graph Edge Draw === */
  @keyframes fin-edge-draw {
    0% { stroke-dashoffset: 100; }
    100% { stroke-dashoffset: 0; }
  }

  .fin-edge-draw {
    stroke-dasharray: 100;
    animation: fin-edge-draw var(--duration-normal) var(--ease-out) forwards;
  }

  /* ================================================================
     Surface Styles
     ================================================================ */

  .fin-surface {
    background: var(--surface-default);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }

  .fin-surface-raised {
    background: var(--surface-default);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-raised);
  }

  .fin-surface-interactive {
    background: var(--surface-default);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    transition: background var(--duration-fastest) var(--ease-out),
                box-shadow var(--duration-fastest) var(--ease-out);
  }

  .fin-surface-interactive:hover {
    background: var(--surface-interactive);
    box-shadow: var(--shadow-interactive);
  }

  .fin-surface-selected {
    background: var(--surface-selected);
    border: 1px solid var(--border-selected);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-selected);
  }

  .fin-surface-floating {
    background: var(--surface-floating);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-floating);
  }

  .fin-surface-overlay {
    background: var(--surface-overlay);
    backdrop-filter: blur(4px);
  }

  .fin-surface-graph {
    background: var(--surface-graph);
    border: none;
    border-radius: 0;
  }

  .fin-surface-terminal {
    background: var(--surface-terminal);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    color: #22c55e;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .fin-surface-timeline {
    background: var(--surface-timeline);
    border-top: 1px solid var(--border-default);
  }

  /* ================================================================
     State Utility Classes
     ================================================================ */

  .fin-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .fin-loading-pulse {
    animation: fin-shimmer 1.5s ease-in-out infinite;
    background: linear-gradient(
      90deg,
      var(--surface-default) 0%,
      var(--surface-interactive) 50%,
      var(--surface-default) 100%
    );
    background-size: 200% 100%;
  }

  @keyframes fin-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .fin-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-8);
    color: var(--text-tertiary);
    text-align: center;
  }

  .fin-error {
    background: var(--color-negative-50);
    border: 1px solid var(--color-negative-200);
    color: var(--color-negative-700);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }

  .dark .fin-error {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.3);
    color: var(--color-negative-400);
  }

  .fin-success {
    background: var(--color-positive-50);
    border: 1px solid var(--color-positive-200);
    color: var(--color-positive-700);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }

  .dark .fin-success {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.3);
    color: var(--color-positive-400);
  }

  .fin-disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
  }

  .fin-focused {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  /* ================================================================
     Accessibility
     ================================================================ */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* ===== Focus Ring Styles ===== */
  .fin-focus-ring {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .fin-focus-ring-inset {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -2px;
  }

  /* ===== Reduced Motion Support ===== */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .fin-loading-pulse,
    .fin-simulation-pulse,
    .fin-risk-pulse {
      animation: none;
    }
  }

  /* ===== High Contrast Support ===== */
  @media (prefers-contrast: high) {
    :root {
      --border-default: #000000;
      --border-strong: #000000;
      --text-primary: #000000;
      --text-secondary: #000000;
      --text-tertiary: #000000;
      --color-focus-ring: #000000;
    }

    .dark {
      --border-default: #ffffff;
      --border-strong: #ffffff;
      --text-primary: #ffffff;
      --text-secondary: #ffffff;
      --text-tertiary: #ffffff;
      --color-focus-ring: #ffffff;
    }
  }

  /* ===== Density Mode Styles ===== */
  .fin-density-compact {
    --density-table-row-height: 32px;
    --density-panel-padding: 8px;
    --density-icon-size: 14px;
    --density-font-size: 12px;
  }

  .fin-density-comfortable {
    --density-table-row-height: 40px;
    --density-panel-padding: 12px;
    --density-icon-size: 16px;
    --density-font-size: 14px;
  }

  .fin-density-spacious {
    --density-table-row-height: 56px;
    --density-panel-padding: 16px;
    --density-icon-size: 18px;
    --density-font-size: 14px;
  }

  /* Alias for backward compatibility */
  .fin-density-analytical {
    --density-table-row-height: 48px;
    --density-panel-padding: 16px;
    --density-icon-size: 18px;
    --density-font-size: 14px;
  }

  /* ===== Live Region for Screen Readers ===== */
  .fin-live-region {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .fin-live-region-alert {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ===== Focus-Visible States ===== */
  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  /* Table row focus (inset) */
  tr:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -2px;
  }

  /* Card/surface focus */
  .fin-surface:focus-visible,
  .fin-surface-raised:focus-visible,
  .fin-surface-interactive:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  /* Dialog/Modal accessibility */
  [role="dialog"]:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -2px;
  }

  /* Command palette input focus */
  [data-command-input]:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  /* ===== Responsive Breakpoints ===== */

  /* Desktop (>=1280px): Full layout — no overrides needed */

  /* Tablet (768-1279px): Collapse left rail, hide household name */
  @media (max-width: 1279px) {
    :root {
      --left-rail-width: 56px;
    }
  }

  /* Mobile (<768px): Full-width workspace, panels as drawers */
  @media (max-width: 767px) {
    :root {
      --left-rail-width: 0px;
      --inspector-min: 0px;
      --inspector-max: 0px;
      --timeline-height: 0px;
    }
  }
}
