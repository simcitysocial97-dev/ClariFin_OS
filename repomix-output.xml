    assert inst_id == "HDFC"

    inst = repo.get("HDFC")
    assert inst is not None
    assert inst["name"] == "HDFC Bank"
    assert inst["type"] == "BANK"
    assert inst["interest_rate_bps"] == 350


def test_institution_list(db_path: str) -> None:
