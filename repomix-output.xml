        result = compute_idle_cash_amount(
            cash_balance_paise=10000000,  # ₹1L
            loan_interest_rate_bps=1500,  # 15%
            deposit_interest_rate_bps=300,  # 3%
        )
        assert result == Decimal("10000000")

