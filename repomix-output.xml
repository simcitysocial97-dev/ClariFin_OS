def make_txn(debit=1_000_000, date="2026-08-01", desc="COFFEE SHOP", **extra):
    txn = {
        "id": 1,
        "account_id": "A1",
        "debit": debit,
        "date_iso": date,
        "description": desc,
    }
    txn.update(extra)
