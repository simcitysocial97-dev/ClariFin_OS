            outstanding_paise=sample_loan_info["outstanding_paise"],
            annual_rate_bps=sample_loan_info["annual_rate_bps"],
            remaining_months=sample_loan_info["remaining_months"],
            prepayment_paise=10000000,
            mode="reduce_tenure",
