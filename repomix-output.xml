            "",
            "## Recommended Improvements",
            "",
            "- TODO: Document recommended improvements",
            "",
        ]
    )

    return "\n".join(lines)


def main() -> None:
    parser = argparse.ArgumentParser(description="Generate validation report")
    parser.add_argument("--output", type=str, help="Output file path")
