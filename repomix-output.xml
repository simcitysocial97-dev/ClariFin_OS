 */
export function EvidenceDrawer({ forecast, isOpen, onClose }: EvidenceDrawerProps) {
  if (!isOpen) return null;

  const evidenceChain: ForecastEvidenceChainViewModel | undefined = forecast?.evidence_chain;

  return (
    <div className="fixed inset-0 z-50 bg-black/50 flex justify-end" onClick={onClose}>
