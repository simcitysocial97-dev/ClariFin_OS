GoalType = Literal[
    "emergency_fund",
    "debt_payoff",
    "purchase",
    "investment",
    "education",
    "retirement",
    "custom",
]

# Priority enumeration
GoalPriority = Literal["critical", "high", "medium", "low"]

# Status enumeration
