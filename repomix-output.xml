# ============================================================

PROVIDER = {
    "provider_name": "CRED",
    "description_pattern": "CRED",
    "typical_settlement_days": 2,
    "fee_min_bps": 100,
    "fee_max_bps": 300,
    "review_fee_min_bps": 301,
    "review_fee_max_bps": 500,
}

PURPOSES = [{"purpose": "rent", "description_pattern": "RENT"}]

