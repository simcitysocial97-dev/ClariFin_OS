// Dynamic import for ES module compatibility
async function runTests() {
    console.log('═══════════════════════════════════════════════════════════════');
    console.log('  SEMANTIC PARSER VALIDATION TEST');
    console.log('═══════════════════════════════════════════════════════════════\n');

