    assert HIGH_INTEREST_THRESHOLD_BPS == 1800
    assert Decimal("0.60") == DEFAULT_DEBT_ALLOCATION_RATIO
    assert Decimal("0.40") == LONG_TERM_GOAL_ALLOCATION_RATIO
