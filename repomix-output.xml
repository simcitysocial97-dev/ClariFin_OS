import { X, FileText, Calculator, Link } from 'lucide-react';
import type { ForecastViewModel, ForecastEvidenceChainViewModel } from '@/types/forecast-view-model';

/**
 * Forecast Evidence Drawer Props
 */
interface EvidenceDrawerProps {
