          <p className="text-xs text-gray-500 mt-1">{step.description}</p>
        </div>
      </div>
    </div>
  );
}

/**
 * Accounts Evidence Drawer Component
 */
export function EvidenceDrawer({ accounts, isOpen, onClose }: EvidenceDrawerProps) {
  if (!isOpen) return null;

  const evidenceChain: AccountEvidenceChainViewModel | undefined = accounts?.evidence_chain;

  return (
    <div className="fixed inset-0 z-50 bg-black/50 flex justify-end" onClick={onClose}>
      <div
        className="bg-white w-full max-w-md h-full overflow-y-auto"
        onClick={(e) => e.stopPropagation()}
        role="dialog"
        aria-label="Accounts evidence drawer"
      >
        <div className="p-4">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-semibold">Evidence</h2>
            <button
              onClick={onClose}
              className="p-1 hover:bg-gray-100 rounded"
              aria-label="Close evidence drawer"
