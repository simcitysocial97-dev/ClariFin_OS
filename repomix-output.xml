    ]

    txn_repo.insert_transactions(stmt_id1, txns1)
    txn_repo.insert_transactions(stmt_id2, txns2)
    txn_repo.insert_transactions(stmt_id3, txns3)

    conn = sqlite3.connect(determinism_db)
