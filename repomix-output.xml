            )
        """)

        conn.execute("""
            INSERT INTO transactions (date_iso, description, amount, debit, credit, account_id, hash_signature)
            VALUES ('2025-01-01', 'Test1', 100, 10000, 0, 1, 'duplicate_hash')
        """)
        conn.execute("""
            INSERT INTO transactions (date_iso, description, amount, debit, credit, account_id, hash_signature)
            VALUES ('2025-01-02', 'Test2', 200, 20000, 0, 1, 'duplicate_hash')
        """)
        conn.commit()
