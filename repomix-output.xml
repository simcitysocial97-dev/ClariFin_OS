      density: 'default',
      radius: 'md',
      borderless: false,
    },
  }
);

// ===== Props =====
export interface SurfaceProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof surfaceVariants> {
  asChild?: boolean;
}

// ===== Surface Component =====
export function Surface({
  className,
