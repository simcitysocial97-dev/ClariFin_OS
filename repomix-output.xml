    assert (
        GENERATED_DIR / "change-impact.md"
    ).exists(), "change-impact.md not found - run check_coverage.py first"


def test_generated_files_have_content() -> None:
    """Generated files must not be empty."""
    for filename in [
        "coverage.md",
        "coverage.json",
        "traceability.md",
        "change-impact.md",
