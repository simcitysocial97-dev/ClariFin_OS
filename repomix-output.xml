@pytest.mark.parametrize(
    "paise,expected_substring",
    [
        (0, "₹0.00"),
        (1, "₹0.01"),
        (99, "₹0.99"),
        (100, "₹1.00"),
        (1000, "₹10.00"),
        (12345678, "₹1,23,456.78"),
        (-50, "-₹"),
        (-100000, "-₹"),
    ],
)
def test_format_paise_parametrized(paise: int, expected_substring: str) -> None:
    """Parametric coverage of paise-to-rupee formatting.

