        assert results[0]["balance_paise"] == 5100000
        # Transaction 2: -1500000 -> 3600000
        assert results[1]["balance_paise"] == 3600000
        # Transaction 3: -50000 -> 3550000
        assert results[2]["balance_paise"] == 3550000
        # Transaction 4: +1000000 -> 4550000
