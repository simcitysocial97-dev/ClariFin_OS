export function ConfidenceBadge({
  confidence,
  className,
  showLabel = true,
}: ConfidenceBadgeProps) {
  const color = useMemo(() => getConfidenceColor(confidence), [confidence]);

  const label = useMemo(() => {
    if (confidence >= 80) return 'High';
    if (confidence >= 50) return 'Medium';
