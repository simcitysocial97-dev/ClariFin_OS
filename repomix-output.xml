  icon?: string;
  deepLink: string;
  viewModelKey: string;
  description?: string;

  // Surface metadata
  defaultSurface: SurfaceType;
  graphAdapter?: string;

  // Runtime integration
  supportedCommands: string[];
  supportedFilters: string[];
  supportedSelections: string[];
  inspectorSections: string[];

  // Keyboard shortcuts
