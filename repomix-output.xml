    def get_selective_pipeline(
        self, selective_plan: dict[str, Any] | None = None
    ) -> list[str]:
        """Get stage IDs for selective verification."""
        pipeline = ["fast", "coverage", "change_intelligence", "mutation_readiness"]

        if selective_plan:
