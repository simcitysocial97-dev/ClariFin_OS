 */
function CalculationStep({ step }: { step: { name: string; description: string; inputs: Record<string, unknown>; outputs: Record<string, unknown> } }) {
  return (
    <div className="border-b pb-3 mb-3 last:border-0 last:pb-0 last:mb-0">
