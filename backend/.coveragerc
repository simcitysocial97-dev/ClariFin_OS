# backend/.coveragerc
# Coverage configuration for pytest-cov
#
# O-2 note: ``fail_under = 40`` is a full-suite coverage floor intended for
# runs that execute the complete backend test suite with coverage enabled.
# Profile scripts that scope coverage to a subset (e.g. the contracts
# profile measuring only ``tests/contract/``) MUST override this floor at
# invocation time (via ``--cov-fail-under=N``) so the floor is enforced
# only against slices it was designed for. Leaving it un-overridden on a
# subset-scoped run conflates slice health with whole-backend health and
# produces a permanent false-red (G7).

[run]
source = src
branch = True
omit =
    # Test infrastructure — never measure tests themselves
    */tests/*
    */conftest.py

    # Application entry points — bootstrap only, not logic
    */main.py
    */startup.py
    */api.py
    */api_common.py
    */health.py

    # Extraction pipeline — requires PDF files, binary I/O
    */statement_extractor.py
    */csv_importer.py
    */ingest.py
    */metadata_extractor.py
    */table_extractor.py
    */transaction_parser.py
    */categorizer.py
    */column_mapper.py
    */validator.py
    */extraction/*
    */structural/*

    # Routers — HTTP layer
    */routers/*

    # Tooling & Scripts — not application core code
    */tools/*
    */scripts/*
    */fix_lint.py
    */diagnose_db.py
    *tools*
    *scripts*

    # Environment and Cache directories
    */site-packages/*
    */.venv/*
    */venv/*
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
# O-2: this floor applies to full-suite runs; subset-scoped profiles must
# override it at invocation (see run_contract_tests.sh comment).
fail_under = 40
precision = 2

exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
    if __name__ == .__main__.:
    \.\.\.$

[html]
directory = tests/generated/coverage-html

[json]
# M9-C43.1 root-cause fix: pytest-cov must write the RAW pytest-cov payload to
# raw-coverage.json — the exact input tools/development/check_coverage.py
# consumes. coverage.json itself is the capability-aware artifact OWNED by
# check_coverage.py (meta test test_coverage_integrity.py::test_coverage_json_valid
# enforces its 'capabilities' structure); the previous path made pytest-cov
# silently clobber it.
output = tests/generated/raw-coverage.json
