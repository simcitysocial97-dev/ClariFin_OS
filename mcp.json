{
  "mcpServers": {
    "CodeGraphContext": {
      "command": "/home/vasantha/.local/bin/cgc",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "DEFAULT_DATABASE": "falkordb",
        "FALKORDB_PATH": "/home/vasantha/.codegraphcontext/global/db/falkordb",
        "FALKORDB_SOCKET_PATH": "/home/vasantha/.codegraphcontext/global/db/falkordb.sock",
        "LADYBUGDB_PATH": "/home/vasantha/.codegraphcontext/global/db/ladybugdb",
        "KUZUDB_PATH": "/home/vasantha/.codegraphcontext/global/db/kuzudb",
        "INDEX_VARIABLES": "true",
        "ALLOW_DB_DELETION": "true",
        "DEBUG_LOGS": "false",
        "DEBUG_LOG_PATH": "/home/vasantha/mcp_debug.log",
        "ENABLE_APP_LOGS": "WARNING",
        "LIBRARY_LOG_LEVEL": "WARNING",
        "LOG_FILE_PATH": "/home/vasantha/.codegraphcontext/logs/cgc.log",
        "MAX_FILE_SIZE_MB": "10",
        "IGNORE_TEST_FILES": "false",
        "IGNORE_HIDDEN_FILES": "true",
        "ENABLE_AUTO_WATCH": "FALSE",
        "COMPLEXITY_THRESHOLD": "10",
        "MAX_DEPTH": "100",
        "PARALLEL_WORKERS": "4",
        "CACHE_ENABLED": "true",
        "IGNORE_DIRS": "node_modules,venv,.venv,env,.env,dist,build,out,.git,.idea,.vscode,__pycache__,public,mocks,servers,memory-bank,docs,test-results,playwright-report,coverage,.next,generated,.pytest_cache,.mypy_cache",
        "INDEX_SOURCE": "true",
        "SCIP_INDEXER": "true",
        "SCIP_LANGUAGES": "python,typescript",
        "SKIP_EXTERNAL_RESOLUTION": "false",
        "MAX_TOOL_RESPONSE_TOKENS": "0",
        "TOOL_RESULT_LIMITS": "{\"find_code\": 50, \"analyze_code_relationships\": 50, \"execute_cypher_query\": 100}",
        "ENABLE_INHERIT_RESOLVE": "true",
        "ENABLE_VECTOR_RESOLVE": "true",
        "CGC_EMBEDDING_MODEL": "local",
        "CGC_EMBEDDING_BATCH_SIZE": "256",
        "FUZZY_SEARCH": "true",
        "ENABLE_SCIP": "true"
      },
      "tools": {
        "alwaysAllow": [
          "add_code_to_graph",
          "add_package_to_graph",
          "check_job_status",
          "list_jobs",
          "find_code",
          "analyze_code_relationships",
          "watch_directory",
          "find_dead_code",
          "execute_cypher_query",
          "calculate_cyclomatic_complexity",
          "find_most_complex_functions",
          "list_indexed_repositories",
          "delete_repository",
          "list_watched_paths",
          "unwatch_directory",
          "visualize_graph_query"
        ],
        "disabledTools": [],
        "disabled": false
      },
      "disabled": false,
      "alwaysAllow": []
    }
  }
}